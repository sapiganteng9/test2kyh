-- Fungsi untuk mendapatkan player sendiri
local function getPlayerKios()
    local character = player.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        return humanoidRootPart
    end
    return nil
end

-- Fungsi untuk menemukan dan trigger ProximityPrompt
local function triggerProximityPrompt()
    local rootPart = getPlayerKios()
    if not rootPart then return false end

    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("ProximityPrompt") then
            local prompt = instance
            local targetPart = prompt.Parent
            
            if targetPart and targetPart:IsA("BasePart") and rootPart and rootPart.Parent then
                local distance = (targetPart.Position - rootPart.Position).Magnitude
                if distance <= prompt.MaxActivationDistance then
                    prompt:InputHoldBegin()
                    task.wait(prompt.HoldDuration or 0.5)
                    prompt:InputHoldEnd()
                    return true
                end
            end
        end
    end
    return false
end

-- Fungsi untuk teleport ke lokasi
local function teleportToLocation(locationPart)
    local playerRoot = getPlayerKios()
    if not playerRoot then
        warn("🚨 Kios player tidak ditemukan!")
        return false
    end

    if locationPart and locationPart.Parent then
        local targetPosition = locationPart.Position + Vector3.new(5, 3, 0)
        playerRoot.CFrame = CFrame.new(targetPosition)
        return true
    end
    
    return false
end

-- Fungsi untuk menjalankan teleport otomatis LOOP
local function startAutoTeleport(startButton)
    if state.isRunning then return end
    
    state.isRunning = true
    state.loopContinue = true

    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    local active = true
    local characterRemovingConn = player.CharacterRemoving:Connect(function()
        active = false
        state.isRunning = false
        characterRemovingConn:Disconnect()
    end)

    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if not state.isRunning or not active or not state.loopContinue then
            connection:Disconnect()
            if characterRemovingConn.Connected then
                characterRemovingConn:Disconnect()
            end
            if startButton then
                startButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
                startButton.Text = "▶ START"
            end
            return
        end

        if #state.selectedLocations > 0 then
            local location = state.selectedLocations[state.currentIndex]
            
            if location and location.part and location.part.Parent then
                if teleportToLocation(location.part) then
                    print("📍 Teleport ke: " .. location.name .. " (" .. location.category .. ")")
                else
                    print("❌ Gagal teleport ke: " .. location.name)
                end
                
                task.wait(0.5)
                
                if state.autoPrompt then
                    if triggerProximityPrompt() then
                        print("✓ ProximityPrompt triggered di: " .. location.name)
                    else
                        print("⚠️ ProximityPrompt tidak ditemukan")
                    end
                end
                
                task.wait(state.teleportDelay)
            end
            
            state.currentIndex = state.currentIndex + 1
            
            if state.currentIndex > #state.selectedLocations then
                state.currentIndex = 1
                print("🔄 Loop berulang...")
            end
        end
    end)
end

-- Fungsi untuk menghentikan teleport
local function stopAutoTeleport(startButton)
    state.isRunning = false
    state.loopContinue = false
    if startButton then
        startButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        startButton.Text = "▶ START"
    end
    print("⏹️ Teleport dihentikan!")
end

-- Fungsi untuk toggle pilihan lokasi
local function toggleLocation(location)
    local found = false
    for i, loc in ipairs(state.selectedLocations) do
        if loc.name == location.name and loc.category == location.category then
            table.remove(state.selectedLocations, i)
            found = true
            break
        end
    end
    
    if not found then
        table.insert(state.selectedLocations, location)
    end
end

