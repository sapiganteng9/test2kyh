-- Fungsi untuk auto-detect lokasi di workspace (TANPA filter owner dulu)
local function autoDetectLocations()
    local categoryMap = {}

    for _, category in ipairs(LOCATION_CATEGORIES) do
        categoryMap[category.category] = {}
        
        for _, locationInfo in ipairs(category.locations) do
            local found = false
            
            for _, obj in pairs(game.Workspace:GetDescendants()) do
                if not found then
                    for _, searchName in ipairs(locationInfo.searchNames) do
                        if string.lower(obj.Name) == string.lower(searchName) then
                            local targetPart = obj
                            if obj:IsA("Model") then
                                targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            end
                            
                            if targetPart and targetPart:IsA("BasePart") then
                                table.insert(categoryMap[category.category], {
                                    name = locationInfo.name,
                                    part = targetPart,
                                    category = category.category,
                                    originalName = obj.Name
                                })
                                found = true
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    
    return categoryMap
end

