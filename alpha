-- FUNGSI UNTUK SCAN SEMUA OBJECT DI WORKSPACE
local function scanAllObjects()
    print("\n🔍 SCANNING WORKSPACE...")
    local allObjects = {}
    
    for _, obj in pairs(game.Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            table.insert(allObjects, {
                name = obj.Name,
                type = obj.ClassName,
                parent = obj.Parent.Name
            })
        end
    end
    
    print("📌 Daftar semua object di workspace:")
    for i, obj in ipairs(allObjects) do
        if i <= 50 then  -- Tampilkan 50 pertama
            print("  " .. obj.name .. " (" .. obj.type .. ") - Parent: " .. obj.parent)
        end
    end
    print("... dan " .. (#allObjects - 50) .. " object lainnya\n")
end

