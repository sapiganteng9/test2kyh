local checkboxButtons = {}

local function createCheckbox(displayName, spawnKey)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 32)
    button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    button.TextColor3 = Color3.fromRGB(230, 230, 230)
    button.TextSize = 12
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Parent = list

    checkboxButtons[spawnKey] = button

    local function update()
        if selectedMaterials[spawnKey] then
            button.Text = "☑  " .. displayName
            button.BackgroundColor3 = Color3.fromRGB(30, 90, 55)
        else
            button.Text = "☐  " .. displayName
            button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        end
    end

    button.MouseButton1Click:Connect(function()
        selectedMaterials[spawnKey] = not selectedMaterials[spawnKey]
        update()
    end)

    update()
end

for _, key in ipairs(materialOrder) do
    local display = keyToDisplay[key] or key
    createCheckbox(display, key)
end

