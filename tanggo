-- ==========================================
-- ROOT PART
-- ==========================================
local function getRootPart()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getNearestCandidate(rootPos, candidates)
    if not candidates or #candidates == 0 then return nil end
    local best = nil
    local bestDist = math.huge
    for _, c in ipairs(candidates) do
        if c.cf and c.cf.Position then
            local d = (c.cf.Position - rootPos).Magnitude
            if d < bestDist then
                bestDist = d
                best = c
            end
        end
    end
    return best
end

local function getDelay()
    return TELEPORT_FIXED
end

-- ==========================================
-- AUTO TELEPORT (gabungan logic untuk SpawnBahan & BahanCraft)
-- - Hanya teleport ke part terdekat per sumber (per spawnKey)
-- ==========================================
task.spawn(function()
    while gui.Parent do
        if autoTeleport then
            local rootPart = getRootPart()
            if rootPart and rootPart.Position then
                for _, spawnKey in ipairs(materialOrder) do
                    if not autoTeleport then break end
                    if selectedMaterials[spawnKey] then
                        local candidates = {}

                        -- CASE A: SpawnBahan style (named items under spawnFolderA)
                        if spawnFolderA and spawnFolderA:IsA("Instance") then
                            for _, item in ipairs(spawnFolderA:GetChildren()) do
                                if not autoTeleport then break end
                                if item.Name == spawnKey and item.Parent then
                                    local success, cf = pcall(function()
                                        return item:GetPivot()
                                    end)
                                    if success and cf then
                                        table.insert(candidates, {obj = item, cf = cf})
                                    end
                                end
                            end
                        end

                        -- CASE B: BahanCraft style (search folder under BahanCraft)
                        if spawnFolderB and spawnFolderB:IsA("Instance") then
                            local folder = spawnFolderB:FindFirstChild(spawnKey)
                            if folder then
                                for _, obj in ipairs(folder:GetDescendants()) do
                                    if not autoTeleport then break end
                                    if obj:IsA("BasePart") and obj.Parent then
                                        local success, cf = pcall(function()
                                            return obj:GetPivot()
                                        end)
                                        if success and cf then
                                            table.insert(candidates, {obj = obj, cf = cf})
                                        end
                                    end
                                end
                            end
                        end

                        -- pilih kandidat terdekat
                        local nearest = getNearestCandidate(rootPart.Position, candidates)
                        if nearest and nearest.cf then
                            -- teleport
                            rootPart.CFrame = nearest.cf + Vector3.new(0, HEIGHT, 0)
                            local delay = getDelay()
                            task.wait(delay)
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

-- ==========================================
-- AUTO PROXIMITY
-- ==========================================
task.spawn(function()
    while gui.Parent do
        if autoPrompt then
            local rootPart = getRootPart()
            if rootPart then
                for _, instance in ipairs(workspace:GetDescendants()) do
                    if not autoPrompt then break end
                    if instance:IsA("ProximityPrompt") then
                        local targetPart = instance.Parent
                        if targetPart and targetPart:IsA("BasePart") and rootPart.Parent then
                            local distance = (targetPart.Position - rootPart.Position).Magnitude
                            if distance <= instance.MaxActivationDistance then
                                pcall(function()
                                    instance:InputHoldBegin()
                                    task.wait(instance.HoldDuration)
                                    instance:InputHoldEnd()
                                end)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

