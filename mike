-- ===== FUNGSI UTILITAS =====

local function findPlayerKios()
    local workspace = game:GetService("Workspace")
    
    for _, item in ipairs(workspace:GetChildren()) do
        if string.find(item.Name, player.Name) or item.Name == "KiosAktif" then
            if item:IsA("Folder") or item:IsA("Model") then
                return item
            end
        end
    end
    
    local playerFolder = workspace:FindFirstChild(tostring(player.UserId))
    if playerFolder then
        for _, child in ipairs(playerFolder:GetChildren()) do
            if child.Name == "Kios" or string.find(child.Name, "Kios") then
                return child
            end
        end
    end
    
    return workspace:FindFirstChild("KiosAktif")
end

local function findLocationInPlayerKios(locationName)
    local playerKios = findPlayerKios()
    if not playerKios then 
        return nil 
    end
    
    local function searchInFolder(folder)
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name == locationName then
                if child:IsA("BasePart") then
                    return child
                elseif child:IsA("Folder") or child:IsA("Model") then
                    local part = searchInFolder(child)
                    if part then return part end
                end
            end
            if child:IsA("Folder") or child:IsA("Model") then
                local part = searchInFolder(child)
                if part then return part end
            end
        end
        return nil
    end
    
    return searchInFolder(playerKios)
end

local function teleportToLocation(locationName)
    if not character or not humanoidRootPart then
        return false
    end
    
    local location = findLocationInPlayerKios(locationName)
    if location then
        if location:IsA("BasePart") then
            humanoidRootPart.CFrame = location.CFrame + Vector3.new(0, 3, 0)
            return true
        else
            for _, child in ipairs(location:GetDescendants()) do
                if child:IsA("BasePart") then
                    humanoidRootPart.CFrame = child.CFrame + Vector3.new(0, 3, 0)
                    return true
                end
            end
        end
    end
    return false
end

-- ===== AUTO PROXIMITY FUNCTION =====
local function triggerProximityPrompts()
    if not proximityActive or not character or not humanoidRootPart then
        return
    end
    
    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("ProximityPrompt") then
            local prompt = instance
            local targetPart = prompt.Parent
            
            if targetPart and targetPart:IsA("BasePart") and humanoidRootPart and humanoidRootPart.Parent then
                local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
                if distance <= prompt.MaxActivationDistance then
                    local success = pcall(function()
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration or 0.5)
                        prompt:InputHoldEnd()
                    end)
                    if success then
                        break -- Hanya trigger satu prompt per cycle
                    end
                end
            end
        end
    end
end

local function getSelectedTargets()
    local targets = {}
    for target, _ in pairs(selectedTargets) do
        table.insert(targets, target)
    end
    return targets
end

