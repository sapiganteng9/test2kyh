-- ===== MAIN LOOP =====
local lastTeleportTime = 0
local lastProximityTime = 0

RunService.Heartbeat:Connect(function()
    if isActive then
        local now = tick()
        
        -- Teleport Logic
        if now - lastTeleportTime >= TELEPORT_DELAY then
            local targets = getSelectedTargets()
            if #targets > 0 then
                local randomTarget = targets[math.random(1, #targets)]
                if teleportToLocation(randomTarget) then
                    print("✓ Teleported to: " .. randomTarget)
                    lastTeleportTime = now
                    task.wait(0.5)
                    
                    -- Trigger Proximity setelah teleport
                    if proximityActive then
                        triggerProximityPrompts()
                    end
                else
                    print("❌ Failed to find location: " .. randomTarget)
                end
            end
        end
    else
        -- Trigger proximity bahkan saat tidak teleport (optional)
        if proximityActive and (tick() - lastProximityTime) >= 0.2 then
            triggerProximityPrompts()
            lastProximityTime = tick()
        end
    end
end)

