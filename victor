-- ============================================
-- FUNCTIONS: TELEPORT
-- ============================================

local function GetTeleportLocations()
    local workspace = game:GetService("Workspace")
    local locations = {}
    
    local bahanCraft = workspace:FindFirstChild("BahanCraft")
    if bahanCraft then
        local batuBesar = bahanCraft:FindFirstChild("BatuBesar")
        local pohonBesar = bahanCraft:FindFirstChild("PohonBesar")
        
        if batuBesar then
            locations.BatuBesar = batuBesar
        end
        if pohonBesar then
            locations.PohonBesar = pohonBesar
        end
    end
    
    return locations
end

local function TeleportToLocation(location)
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    if not location or not location:FindFirstChild("HumanoidRootPart") then return end
    
    local targetPos = location.HumanoidRootPart.Position + Vector3.new(math.random(-5, 5), 3, math.random(-5, 5))
    Character:MoveTo(targetPos)
end

local function AutoTeleport()
    while Config.TeleportEnabled do
        local locations = GetTeleportLocations()
        
        if Config.SelectedLocations.BatuBesar and locations.BatuBesar then
            TeleportToLocation(locations.BatuBesar)
            task.wait(Config.TeleportDelay)
        end
        
        if Config.SelectedLocations.PohonBesar and locations.PohonBesar then
            TeleportToLocation(locations.PohonBesar)
            task.wait(Config.TeleportDelay)
        end
        
        task.wait(0.1)
    end
end

-- ============================================
-- FUNCTIONS: AUTO SWING
-- ============================================

local function GetNearbyResources()
    local workspace = game:GetService("Workspace")
    local bahanCraft = workspace:FindFirstChild("BahanCraft")
    local nearbyResources = {}
    
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then
        return nearbyResources
    end
    
    local playerPos = Character.HumanoidRootPart.Position
    
    if bahanCraft then
        for _, resource in ipairs(bahanCraft:GetChildren()) do
            if resource:IsA("Model") and resource:FindFirstChild("HumanoidRootPart") then
                local resourcePos = resource.HumanoidRootPart.Position
                local distance = (playerPos - resourcePos).Magnitude
                
                if resource.Name == "PohonBesar" and distance <= Config.ProximityDistance.PohonBesar then
                    table.insert(nearbyResources, {name = "PohonBesar", distance = distance, model = resource})
                elseif resource.Name == "BatuBesar" and distance <= Config.ProximityDistance.BatuBesar then
                    table.insert(nearbyResources, {name = "BatuBesar", distance = distance, model = resource})
                end
            end
        end
    end
    
    return nearbyResources
end

local function GetEquippedTool()
    if not Character then return nil end
    
    for _, item in ipairs(Character:GetChildren()) do
        if item:IsA("Tool") and item:GetAttribute("AlatTambang") then
            return item
        end
    end
    
    return nil
end

local function ActivateToolSwing(tool)
    if not tool or not tool:FindFirstChild("Handle") then return end
    
    -- Coba activate tool
    if tool:FindFirstChild("Activated") then
        tool.Activated:Fire()
    elseif tool:GetAttribute("Activated") then
        tool:SetAttribute("Activated", true)
    else
        -- Fallback: buat event manual
        local event = Instance.new("StringValue")
        event.Name = "toolanim"
        event.Value = "Slash"
        event.Parent = tool
        game:GetService("Debris"):AddItem(event, 0.5)
    end
end

local function AutoSwing()
    while Config.SwingEnabled do
        local nearbyResources = GetNearbyResources()
        
        if #nearbyResources > 0 then
            local tool = GetEquippedTool()
            
            if tool then
                -- Swing otomatis
                ActivateToolSwing(tool)
                task.wait(Config.HoldDuration)
            else
                task.wait(0.5)
            end
        else
            task.wait(0.5)
        end
    end
end

