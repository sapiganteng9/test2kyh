-- root part
local function getRootPart()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getDelay()
    return TELEPORT_FIXED
end

-- AUTO TELEPORT: teleport to ALL matching candidates
task.spawn(function()
    while gui.Parent do
        if autoTeleport then
            local rootPart = getRootPart()
            if rootPart and rootPart.Position then
                for _, spawnKey in ipairs(materialOrder) do
                    if not autoTeleport then break end
                    if selectedMaterials[spawnKey] then
                        -- SpawnBahan style
                        if spawnFolderA and spawnFolderA:IsA("Instance") then
                            for _, item in ipairs(spawnFolderA:GetChildren()) do
                                if not autoTeleport then break end
                                if item.Name == spawnKey and item.Parent then
                                    local ok, cf = pcall(function() return item:GetPivot() end)
                                    if ok and cf then
                                        rootPart.CFrame = cf + Vector3.new(0, HEIGHT, 0)
                                        print("[AutoTeleport] Teleported to spawn:", spawnKey)
                                        task.wait(getDelay())
                                    end
                                end
                            end
                        end

                        -- BahanCraft style: find folder and then all matching descendants named as folderChild[spawnKey]
                        if spawnFolderB and spawnFolderB:IsA("Instance") then
                            local folder = spawnFolderB:FindFirstChild(spawnKey)
                            if folder then
                                local targetName = folderChild[spawnKey]
                                if targetName then
                                    for _, obj in ipairs(folder:GetDescendants()) do
                                        if not autoTeleport then break end
                                        if obj.Name == targetName and obj:IsA("BasePart") and obj.Parent then
                                            local ok, cf = pcall(function() return obj:GetPivot() end)
                                            if ok and cf then
                                                rootPart.CFrame = cf + Vector3.new(0, HEIGHT, 0)
                                                print("[AutoTeleport] Teleported to BahanCraft:", spawnKey, "->", targetName)
                                                task.wait(getDelay())
                                            end
                                        end
                                    end
                                else
                                    -- fallback: all BaseParts
                                    for _, obj in ipairs(folder:GetDescendants()) do
                                        if not autoTeleport then break end
                                        if obj:IsA("BasePart") and obj.Parent then
                                            local ok, cf = pcall(function() return obj:GetPivot() end)
                                            if ok and cf then
                                                rootPart.CFrame = cf + Vector3.new(0, HEIGHT, 0)
                                                print("[AutoTeleport] Teleported to BahanCraft fallback:", spawnKey)
                                                task.wait(getDelay())
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

-- AUTO PROXIMITY: maintain dynamic registry and handle Attachment->BasePart parents
local promptRegistry = {}
local lastActivated = {}

local function registerPrompt(p)
    if p and p:IsA and p:IsA("ProximityPrompt") then
        promptRegistry[p] = true
        -- update debug count
        local count = 0 for _ in pairs(promptRegistry) do count = count + 1 end
        debugLabel.Text = ("Debug: prompts=%d"):format(count)
        print("[AutoProx] Registered prompt:", p.Name)
    end
end

local function unregisterPrompt(p)
    if promptRegistry[p] then
        promptRegistry[p] = nil
        lastActivated[p] = nil
        local count = 0 for _ in pairs(promptRegistry) do count = count + 1 end
        debugLabel.Text = ("Debug: prompts=%d"):format(count)
        print("[AutoProx] Unregistered prompt:", p.Name)
    end
end

-- initial collect
for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA and d:IsA("ProximityPrompt") then
        registerPrompt(d)
    end
end

workspace.DescendantAdded:Connect(function(d)
    if d and d:IsA and d:IsA("ProximityPrompt") then
        registerPrompt(d)
    end
end)

workspace.DescendantRemoving:Connect(function(d)
    if d and d:IsA and d:IsA("ProximityPrompt") then
        unregisterPrompt(d)
    end
end)

task.spawn(function()
    while gui.Parent do
        if autoPrompt then
            local rootPart = getRootPart()
            if rootPart and rootPart.Position then
                -- snapshot keys to avoid mutation issues while iterating
                local prompts = {}
                for p in pairs(promptRegistry) do table.insert(prompts, p) end

                for _, promptObj in ipairs(prompts) do
                    if not autoPrompt then break end
                    if not promptObj or not promptObj.Parent then
                        promptRegistry[promptObj] = nil
                        lastActivated[promptObj] = nil
                        goto continue_in_loop
                    end

                    if not promptObj.Enabled then
                        goto continue_in_loop
                    end

                    -- climb ancestors until BasePart found (Attachment -> BasePart)
                    local base = promptObj.Parent
                    while base and not base:IsA("BasePart") do
                        base = base.Parent
                    end
                    if not base or not base:IsA("BasePart") then
                        goto continue_in_loop
                    end

                    local ok, dist = pcall(function()
                        return (base.Position - rootPart.Position).Magnitude
                    end)
                    if not ok or not dist then
                        goto continue_in_loop
                    end

                    if dist <= (promptObj.MaxActivationDistance or 0) then
                        local now = tick()
                        local last = lastActivated[promptObj] or 0
                        if now - last >= 0.5 then
                            local success, err = pcall(function()
                                promptObj:InputHoldBegin()
                                local hold = promptObj.HoldDuration or 0.1
                                task.wait(hold)
                                promptObj:InputHoldEnd()
                            end)
                            if success then
                                debugLabel.Text = ("Debug: Activated '%s' (%.1f)"):format(tostring(promptObj.Name), dist)
                                print(string.format("[AutoProx] Activated prompt '%s' (dist=%.2f)", tostring(promptObj.Name), dist))
                            else
                                warn("[AutoProx] Failed to activate prompt:", promptObj, err)
                            end
                            lastActivated[promptObj] = now
                            task.wait(0.05)
                        end
                    end

                    ::continue_in_loop::
                end
            end
        end
        task.wait(0.12)
    end
end)

