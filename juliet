local success, error = pcall(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")

    local player = Players.LocalPlayer
    local mouse = player:GetMouse()

    if not player then
        warn("[JAGA LILIN] Player tidak ditemukan!")
        return
    end

    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then
        warn("[JAGA LILIN] PlayerGui tidak ditemukan!")
        return
    end

    local CONFIG = {
        windowTitle = "JAGA LILIN",
        watermark = "by SAPIGANTENG",
        defaultDelay = 2,
        minDelay = 1,
        maxDelay = 100
    }

    local scriptState = {
        isRunning = false,
        delay = CONFIG.defaultDelay,
        selectedTargets = {},
        windowMinimized = false,
        windowDragging = false,
        dragStart = Vector2.new(0, 0),
        windowStart = UDim2.new(0, 0, 0, 0)
    }

    local DISPLAY_NAMES = {
        pemotongan = "Pemotongan",
        jamurKuburan = "Jamur Kuburan",
        pisangRajaRebus = "Pisang Raja Rebus",
        sateGagak = "Sate Gagak",
        sateKepiting = "Sate Kepiting",
        tumiKamboja = "Tumis Kamboja",
        rakDupa = "Rak Dupa",
        rakKemenyan = "Rak Kemenyan",
        rakKepiting = "Rak Kepiting",
        rakMelati = "Rak Melati"
    }

    local function getPlayerKios()
        local playerName = player.Name
        local kiosAktif = workspace:FindFirstChild("KiosAktif")
        
        if not kiosAktif then
            return nil
        end
        
        local playerKios = kiosAktif:FindFirstChild("Kios_(" .. playerName .. ")")
        return playerKios
    end

    local function getTeleportPart(targetKey)
        local playerKios = getPlayerKios()
        if not playerKios then
            return nil
        end

        local pathMap = {
            pemotongan = function()
                local alatMasak = playerKios:FindFirstChild("AlatMasak")
                if alatMasak then
                    return alatMasak:FindFirstChild("pemotongan")
                end
                return nil
            end,
            jamurKuburan = function()
                local mejamakan = playerKios:FindFirstChild("Mejamakan")
                if mejamakan then
                    return mejamakan:FindFirstChild("JamurKuburan")
                end
                return nil
            end,
            pisangRajaRebus = function()
                local mejamakan = playerKios:FindFirstChild("Mejamakan")
                if mejamakan then
                    return mejamakan:FindFirstChild("Pisang raja rebus")
                end
                return nil
            end,
            sateGagak = function()
                local mejamakan = playerKios:FindFirstChild("Mejamakan")
                if mejamakan then
                    return mejamakan:FindFirstChild("SateGagak")
                end
                return nil
            end,
            sateKepiting = function()
                local mejamakan = playerKios:FindFirstChild("Mejamakan")
                if mejamakan then
                    return mejamakan:FindFirstChild("SateKepiting")
                end
                return nil
            end,
            tumiKamboja = function()
                local mejamakan = playerKios:FindFirstChild("Mejamakan")
                if mejamakan then
                    return mejamakan:FindFirstChild("Tumis kamboja")
                end
                return nil
            end,
            rakDupa = function()
                local rak = playerKios:FindFirstChild("Rak")
                if rak then
                    return rak:FindFirstChild("RakDupa")
                end
                return nil
            end,
            rakKemenyan = function()
                local rak = playerKios:FindFirstChild("Rak")
                if rak then
                    return rak:FindFirstChild("RakKemenyan")
                end
                return nil
            end,
            rakKepiting = function()
                local rak = playerKios:FindFirstChild("Rak")
                if rak then
                    return rak:FindFirstChild("RakKepiting")
                end
                return nil
            end,
            rakMelati = function()
                local rak = playerKios:FindFirstChild("Rak")
                if rak then
                    return rak:FindFirstChild("RakMelati")
                end
                return nil
            end,
        }

        if pathMap[targetKey] then
            return pathMap[targetKey]()
        end

        return nil
    end

    local function teleportToTarget(targetKey)
        local targetPart = getTeleportPart(targetKey)

        if not targetPart then
            return false
        end

        local character = player.Character
        if not character then return false end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return false end

        pcall(function()
            local teleportPos = targetPart.Position + Vector3.new(0, 3, 0)
            rootPart.CFrame = CFrame.new(teleportPos)
        end)

        task.wait(0.3)
        return true
    end

    local function executeProximityPrompts()
        local character = player.Character
        if not character then return end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        for _, instance in ipairs(workspace:GetDescendants()) do
            if instance:IsA("ProximityPrompt") then
                local prompt = instance
                local targetPart = prompt.Parent

                if targetPart and targetPart:IsA("BasePart") and rootPart and rootPart.Parent then
                    local distance = (targetPart.Position - rootPart.Position).Magnitude
                    if distance <= (prompt.MaxActivationDistance or 20) then
                        pcall(function()
                            prompt:InputHoldBegin()
                            task.wait(prompt.HoldDuration or 0.5)
                            prompt:InputHoldEnd()
                        end)
                        task.wait(0.1)
                    end
                end
            end
        end
    end

    -- ==================== GUI CREATION ====================
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "JagaLilinGui"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = playerGui

    local mainWindow = Instance.new("Frame")
    mainWindow.Name = "MainWindow"
    mainWindow.Size = UDim2.new(0, 350, 0, 600)
    mainWindow.Position = UDim2.new(0.5, -175, 0.5, -300)
    mainWindow.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    mainWindow.BorderSizePixel = 0
    mainWindow.Parent = screenGui
    mainWindow.Active = true

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = mainWindow

    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1, 0, 0, 40)
    titleBar.BackgroundColor3 = Color3.fromRGB(20, 120, 200)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = mainWindow
    titleBar.Active = true

    local titleCorner = Instance.new("UICorner")
    titleCorner.CornerRadius = UDim.new(0, 10)
    titleCorner.Parent = titleBar

    local titleText = Instance.new("TextLabel")
    titleText.Text = CONFIG.windowTitle
    titleText.Size = UDim2.new(1, -80, 1, 0)
