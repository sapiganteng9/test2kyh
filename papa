-- TAB 5: FITUR UTILITAS & ANTI-AFK
-- ==========================================
local Tab5 = Window:NewTab("Utilities")
local Section5 = Tab5:NewSection("Sistem Pengaman")

Section5:NewButton("Aktifkan Anti-AFK (Anti-Kick)", "Mencegah putus koneksi setelah 20 menit idle", function()
    local vu = game:GetService("VirtualUser")
    game.Players.LocalPlayer.Idled:Connect(function()
        vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
    Library:Notify("Anti-AFK Aktif!", "Anda tidak akan terkena kick dari server.", 5)
end)

