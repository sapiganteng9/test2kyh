-- ==========================================
-- TAB 3: DAPUR (AUTO MASAK & INSTANT)
-- ==========================================
local Tab3 = Window:NewTab("Cooking Kitchen")
local Section3 = Tab3:NewSection("Otomatisasi Kompor")

_G.AutoMasak = false
Section3:NewToggle("Auto Masak & Masak Instan", "Interaksi kompor + bypass durasi masak", function(state)
    _G.AutoMasak = state
    
    -- Loop Interaksi Kompor
    task.spawn(function()
        while _G.AutoMasak do
            task.wait(0.3)
            pcall(function()
                for _, v in pairs(Workspace:GetDescendants()) do
                    if not _G.AutoMasak then break end
                    if v:IsA("ProximityPrompt") and v.Parent then
                        local parentName = v.Parent.Name:lower()
                        local actionText = v.ActionText:lower()
                        if parentName:find("kompor") or parentName:find("stove") or actionText:find("masak") then
                            fireproximityprompt(v)
                        end
                    end
                end
            end)
        end
    end)
    
    -- Loop Bypass Remote Event (Masak Instan)
    task.spawn(function()
        while _G.AutoMasak do
            task.wait(0.1)
            pcall(function()
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if not _G.AutoMasak then break end
                    if remote:IsA("RemoteEvent") then
                        local remoteName = remote.Name:lower()
                        if remoteName:find("cook") or remoteName:find("masak") or remoteName:find("finish") then
                            remote:FireServer(true)
                        end
                    end
                end
            end)
        end
    end)
end)

-- ==========================================
-- TAB 4: BERBURU (AUTO POTONG GAGAK FULL OTOMATIS)
-- ==========================================
local Tab4 = Window:NewTab("Crow Hunter")
local Section4 = Tab4:NewSection("Gagak Fitur")

_G.AutoGagak = false
Section4:NewToggle("FULL AUTO POTONG GAGAK", "Teleport & potong mandiri tanpa sentuh layar", function(state)
    _G.AutoGagak = state
    task.spawn(function()
        while _G.AutoGagak do
            task.wait(0.1)
            local gagakDitemukan = false
            pcall(function()
                for _, v in pairs(Workspace:GetDescendants()) do
                    if not _G.AutoGagak then break end
                    if v:IsA("ProximityPrompt") and v.Parent then
                        local parentName = v.Parent.Name:lower()
                        local actionText = v.ActionText:lower()
                        if parentName:find("gagak") or parentName:find("crow") or actionText:find("potong") or actionText:find("harvest") then
                            gagakDitemukan = true
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                LocalPlayer.Character.HumanoidRootPart.CFrame = v.Parent.CFrame
                                task.wait(0.05)
                                v.HoldDuration = 0
                                fireproximityprompt(v)
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end)
            if not gagakDitemukan then task.wait(0.5) end
        end
    end)
end)

