-- Update Location List
local function updateLocationList()
	-- Hapus item lama
	for _, child in ipairs(locationContainer:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	local destinations = TELEPORT_DESTINATIONS[guiState.selectedCategory]
	if not destinations then return end
	
	for i, dest in ipairs(destinations) do
		local btn = Instance.new("TextButton")
		btn.Name = "Location_" .. i
		btn.Size = UDim2.new(1, 0, 0, 30)
		btn.BackgroundColor3 = if guiState.selectedDestination == i then Color3.fromRGB(100, 150, 255) else Color3.fromRGB(55, 65, 85)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextSize = 11
		btn.Font = Enum.Font.Gotham
		btn.Text = "📍 " .. dest.name
		btn.Parent = locationContainer
		btn.LayoutOrder = i
		
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 5)
		btnCorner.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			guiState.selectedDestination = i
			updateLocationList()
			updateStatus("✓ Lokasi: " .. dest.name .. " dipilih")
		end)
	end
end

