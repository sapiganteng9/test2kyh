	if guiState.teleportMode == "all" then
		allBtn.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
		singleBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
		categoryLabel.Visible = false
		categoryContainer.Visible = false
		locationLabel.Visible = false
		locationContainer.Visible = false
		updateStatus("✓ Mode: SEMUA LOKASI")
	else
		allBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
		singleBtn.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
		categoryLabel.Visible = true
		categoryContainer.Visible = true
		locationLabel.Visible = true
		locationContainer.Visible = true
		updateLocationList()
		updateStatus("✓ Mode: PILIH LOKASI")
	end
end

-- ==================== EVENT HANDLERS ====================

-- Drag functionality
local dragging = false
local dragStart = nil
local frameStart = nil

titleBar.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		frameStart = mainFrame.Position
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		mainFrame.Position = frameStart + UDim2.new(0, delta.X, 0, delta.Y)
	end
end)

-- Minimize
minimizeBtn.MouseButton1Click:Connect(function()
	guiState.isOpen = not guiState.isOpen
	contentFrame.Visible = guiState.isOpen
	if guiState.isOpen then
		mainFrame.Size = UDim2.new(0, 380, 0, 550)
		minimizeBtn.Text = "—"
	else
		mainFrame.Size = UDim2.new(0, 380, 0, 45)
		minimizeBtn.Text = "+"
	end
end)

-- Close
closeBtn.MouseButton1Click:Connect(function()
	screenGui:Destroy()
end)

-- Mode buttons
allBtn.MouseButton1Click:Connect(function()
	guiState.teleportMode = "all"
	updateModeButtons()
end)

singleBtn.MouseButton1Click:Connect(function()
	guiState.teleportMode = "single"
	updateModeButtons()
end)

-- Start/Stop buttons
startBtn.MouseButton1Click:Connect(function()
	local delay = tonumber(delayInput.Text) or 5
	if delay < 1 then delay = 1 end
	guiState.teleportDelay = delay
	startTeleporting()
end)

stopBtn.MouseButton1Click:Connect(function()
	stopTeleporting()
end)

-- Delay input validation
delayInput.FocusLost:Connect(function()
	local value = tonumber(delayInput.Text)
	if value and value > 0 then
		guiState.teleportDelay = value
	else
		delayInput.Text = tostring(guiState.teleportDelay)
	end
end)

-- Hover effects
for _, btn in ipairs({allBtn, singleBtn, startBtn, stopBtn, minimizeBtn, closeBtn}) do
	btn.MouseEnter:Connect(function()
		btn.TextTransparency = 0.8
	end)
	btn.MouseLeave:Connect(function()
		btn.TextTransparency = 0
	end)
end

