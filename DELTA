-- ==================== FUNGSI UTILITY ====================

-- Fungsi untuk menemukan Kios Aktif milik player sendiri
local function findPlayerKiosAktif()
	local playerName = player.Name
	
	for _, model in ipairs(workspace:FindPartBoundsInRadius(Vector3.new(0, 0, 0), math.huge):GetChildren()) do
		if model:IsA("Model") and model.Name == "KiosAktif" then
			-- Cek owner property
			local ownerValue = model:FindFirstChild("Owner")
			if ownerValue and ownerValue:IsA("StringValue") then
				if ownerValue.Value == playerName then
					print("✓ Ditemukan Kios Aktif milik: " .. playerName)
					return model
				end
			elseif ownerValue and ownerValue:IsA("ObjectValue") then
				if ownerValue.Value and ownerValue.Value.Name == playerName then
					return model
				end
			end
		end
	end
	
	-- Fallback: cari Kios Aktif pertama
	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model") and model.Name == "KiosAktif" then
			local ownerValue = model:FindFirstChild("Owner")
			if not ownerValue then
				print("⚠ Menggunakan Kios Aktif tanpa Owner property")
				return model
			end
		end
	end
	
	return nil
end

-- Fungsi untuk mendapatkan Part dari folder Kios Aktif
local function getDestinationPart(category, locationName)
	local kios = findPlayerKiosAktif()
	if not kios then
		warn("❌ Kios Aktif tidak ditemukan!")
		return nil
	end
	
	local categoryFolder = kios:FindFirstChild(category)
	if not categoryFolder then
		warn("❌ Kategori '" .. category .. "' tidak ditemukan!")
		return nil
	end
	
	local part = categoryFolder:FindFirstChild(locationName)
	if not part or not part:IsA("BasePart") then
		warn("❌ Lokasi '" .. locationName .. "' tidak ditemukan atau bukan Part!")
		return nil
	end
	
	return part
end

-- Fungsi untuk teleport menggunakan Humanoid:MoveTo()
local function moveToLocation(targetPart)
	if not targetPart or not targetPart.Parent then
		warn("❌ Part target tidak ditemukan!")
		return false
	end
	
	local character = player.Character
	if not character then return false end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChild("Humanoid")
	
	if not humanoidRootPart or not humanoid then return false end
	
	-- Gunakan MoveTo untuk pergerakan natural
	local targetPosition = targetPart.Position + targetPart.CFrame.LookVector * 5
	humanoid:MoveTo(targetPosition)
	
	-- Tunggu hingga tiba di lokasi atau timeout 20 detik
	local moveStartTime = tick()
	while (humanoidRootPart.Position - targetPosition).Magnitude > 5 do
		if tick() - moveStartTime > 20 then
			warn("⏱ Timeout: Tidak bisa mencapai lokasi")
			return false
		end
		task.wait(0.1)
	end
	
	return true
end

-- Fungsi untuk mengaktifkan ProximityPrompt
local function activateProximityPrompt()
	local character = player.Character
	if not character then return false end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart or not humanoidRootPart.Parent then return false end
	
	-- Cari ProximityPrompt di sekitar pemain
	for _, instance in ipairs(workspace:GetDescendants()) do
		if instance:IsA("ProximityPrompt") then
			local prompt = instance
			local targetPart = prompt.Parent
			
			if targetPart and targetPart:IsA("BasePart") then
				local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
				if distance <= prompt.MaxActivationDistance then
					print("✓ Mengaktifkan ProximityPrompt: " .. targetPart.Name)
					prompt:InputHoldBegin()
					task.wait(guiState.proximityHoldTime)
					prompt:InputHoldEnd()
					return true
				end
			end
		end
	end
	
	return false
end

-- Fungsi untuk mendapatkan semua destinasi
local function getAllDestinations()
	local all = {}
	for category, destinations in pairs(TELEPORT_DESTINATIONS) do
		for _, dest in ipairs(destinations) do
			table.insert(all, {category = category, name = dest.name})
		end
	end
	return all
end

-- Fungsi untuk update status label
local function updateStatus(message)
	guiState.currentStatus = message
	print("📊 " .. message)
end

-- ==================== LOGIKA TELEPORT ====================

local function startTeleporting()
	if guiState.isTeleporting then return end
	guiState.isTeleporting = true
	
	local destinations
	if guiState.teleportMode == "all" then
		destinations = getAllDestinations()
	else
		destinations = TELEPORT_DESTINATIONS[guiState.selectedCategory]
		if not destinations then return end
		destinations = {destinations[guiState.selectedDestination]}
	end
	
	task.spawn(function()
		for i, dest in ipairs(destinations) do
			if not guiState.isTeleporting then break end
			
			updateStatus("⏳ Menunggu jeda: " .. guiState.teleportDelay .. "s")
			task.wait(guiState.teleportDelay)
			
			if not guiState.isTeleporting then break end
			
			updateStatus("🚀 Teleporting ke: " .. dest.name)
			
			-- Dapatkan destination part
			local targetPart = getDestinationPart(dest.category, dest.name)
			if not targetPart then
				updateStatus("❌ Gagal: " .. dest.name .. " tidak ditemukan")
				continue
			end
			
			-- Teleport menggunakan MoveTo
			local success = moveToLocation(targetPart)
			if success then
				updateStatus("✓ Tiba di: " .. dest.name)
				task.wait(1)
				
				-- Aktifkan ProximityPrompt
				updateStatus("🔘 Mengaktifkan ProximityPrompt...")
				activateProximityPrompt()
				task.wait(0.5)
			else
				updateStatus("❌ Gagal mencapai: " .. dest.name)
			end
		end
		
		guiState.isTeleporting = false
		updateStatus("✅ Selesai!")
	end)
end

local function stopTeleporting()
	guiState.isTeleporting = false
	updateStatus("⏹ Dihentikan")
end

